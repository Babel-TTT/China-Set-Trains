// Begin RD1

// Graphics
spriteset (spriteset_rd1_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("diesel", "rd1/rd1")
}
spriteset (spriteset_rd1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("diesel", "rd1/rd1")
}
switch (FEAT_TRAINS, SELF, switch_rd1_articulated_part, extra_callback_info1) {
    1..2: return rd1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}




switch (FEAT_TRAINS, SELF, switch_rd1_graphics, position_in_articulated_veh % 3) {
    1: spriteset_rd1;
    empty_sprites;
}


item (FEAT_TRAINS, rd1) {
    property {
        // Menu
        name:                           string(STR_NAME_RD1);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_DIESEL;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1969,12,26);
        model_life:                     20;
        retire_early:                   10;
        vehicle_life:                   15;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_CARGO;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          100 km/h;
        power:                          3000 hpM;
        weight:                         135 ton;
        tractive_effort_coefficient:    0.321;
        cost_factor:                    53;
        running_cost_base:              RUNNING_COST_DIESEL;
        running_cost_factor:            72;
        reliability_decay:              32;
        bitmask_vehicle_info:           0;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_5, string(STR_FULL_NAME_RD1), string(STR_ELECTRICITY_SUPPLY_NO), string(STR_RELDEC_HIGH, 20));
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_rd1_graphics;
        purchase:                       spriteset_rd1_purchase;
        articulated_part:               switch_rd1_articulated_part;

        // Stats
        length:                         switch_length_2_6_2;
        cargo_capacity:                 0;
        cost_factor:                    60;
        running_cost_factor:            70 * runningcostfactor();
        purchase_running_cost_factor:   280;
        purchase_cargo_capacity:        0;
    }
}

// End RD1
