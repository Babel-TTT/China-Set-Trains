// Begin DEKII

// Graphics

// Purchase Menu
spriteset (spriteset_dekii_purchase_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("1500-electric", "dekii")
}

// Vehicle
spriteset (spriteset_dekii_original, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("1500-electric", "dekii")
}

switch (FEAT_TRAINS, SELF, switch_dekii_articulated_part, extra_callback_info1) {
    1..2: return dekii;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_dekii_graphics, position_in_articulated_veh % 3) {
    1: spriteset_dekii_original;
    empty_sprites;
}


item (FEAT_TRAINS, dekii) {
    property {
        // Menu
        name:                           string(STR_NAME_DEKII);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        engine_class:                   ENGINE_CLASS_ELECTRIC;

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1930,01,01);
        model_life:                     60;
        retire_early:                   40;
        vehicle_life:                   30;
        track_type:                     SACd;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   0;
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
        refit_cost:                     0;
        default_cargo_type:             PASS;
        ai_special_flag:                AI_FLAG_PASSENGER;
        cargo_capacity:                 1;
        loading_speed:                  8 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          50 km/h;
        power:                          552 kW;
        weight:                         61 ton;
        tractive_effort_coefficient:    0.19;
        cost_factor:                    50;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            50;
        reliability_decay:              16;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_4,string(STR_SMR_VEHICLE),  string(STR_ELECTRICITY_SUPPLY_NO),  string(STR_RELDEC_MEDIUM, 16));
        can_attach_wagon:               locowagon;
        // Graphics
        default:                        switch_dekii_graphics;
        purchase:                       spriteset_dekii_purchase_original;
        articulated_part:               switch_dekii_articulated_part;

        // Stats
        length:                         switch_length_2_1_2;
        cargo_capacity:                 0;
        cost_factor:                    50;
        running_cost_factor:            16 * runningcostfactor();
        purchase_running_cost_factor:   64;
        purchase_cargo_capacity:        0;
        bitmask_vehicle_info:           0;
    }
}

// End DEKII