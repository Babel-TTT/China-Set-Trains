/*
Using Semi-Standardised Railtype Scheme.
The First Letter:
S - 1435 mm gauge
B - 1520 mm gauge
N - 1067(1000) mm gauge
n - 762(600) mm gauge
D - 1435/1520 mm gauge
d - 1435/1067(1000) mm gauge
MONO - Monorail;
MGLV - Magnetic Levitation (Maglev);

The Second Letter:
For S, B, D gauges:
A - 80 km/h
B - 120 km/h
C - 160 km/h
D - 210 km/h
E - 250 km/h (unlimited for B gauge)
F - 310 km/h
G - Unlimited;
For N, d gauges:
A - 95 km/h
B - 130 km/h
C - 160 km/h;
For n gauges:
A - 60 km/h;
For Monorail:
A - Unlimited;
For Maglev:
A - 120 km/h
B - Unlimited;

The Third Letter for Standard/Broad Gauges:
A - Very Low Axle Load - <= 15 t
B - Low Axle Load - 16-19 t
C - Medium Axle Load - 20-23 t
D - High Axle Load - 24-26 t
E - Very High Axle Load - >= 27 t;

The Last Letter:
N - Non-Electrified
A - 25 kV AC
d - 1.5 kV DC
( - 25 kV AC / 1.5 kV DC
3 - Third Rail Electrification
Z - Third Rail / 1.5 kV DC;
*/

/* Tracktypes in China Set: Rails:

RAIL, ELRL, MONO, MGLV,
SADN, SAEN, SBDN, SBEN, SCDN,
SBDA, SBEA, SCCA, SCDA, SDCA, SDDA, SECA, SEDA, SFCA, SGCA,
SADD, SBDD, SCDD, (3kV for DPRK and Russia)
SADd, SBDd, SCCd, (1.5kV: Industrial Railways and Metros)
SAC3, SBC3,
SACZ,
SBC(,
SADE, (60 km/h, universal)
NAAN, NBAN, NCAN,
NAAA, NBAA, NCAA,
nAAN,
nAAA,
BADN, BAEN, BBDN, BBEN, BCDN,
BBDA, BBEA, BCCA, BDDA, BECA,
DBCN, DCDA,
DBCN, dCDA.

48 + 4 = 52
*/

railtypetable {
    RAIL,
    ELRL,
    MONO,
    MGLV,
//非电气化准轨
    SAAN: [SAAN, SABN, SACN, SADN, SAEN, RAIL],       //兼容性保留
    SABN: [SABN, SACN, SADN, SAEN, SAAN, RAIL], 
    SACN: [SACN, SADN, SAEN, SAAN, RAIL], 
    SADN: [SADN, SAEN, SAAN, RAIL],
    SAEN: [SAEN, SAAN, RAIL],
//25kv准轨
    SAAA: [SAAA, SABA, SACA, SADA, SAEA, SAAE, ELRL],       
    SABA: [SABA, SACA, SADA, SAEA, SAAA, SAAE, ELRL], 
    SACA: [SACA, SADA, SAEA, SAAA, SAAE, ELRL], 
    SADA: [SADA, SAEA, SAAA, SAAE, ELRL], 
    SAEA: [SAEA, SAAA, SAAE, ELRL],
//3kV准轨
    SAAD: [SAAD, SAAE, ELRL], 
    SABD: [SABD, SACD, SADD, SAAD, SAAE, ELRL], 
    SACD: [SACD, SADD, SAAD, SAAE, ELRL], 
    SADD: [SADD, SAAD, SAAE, ELRL],
//1.5kV准轨
    SAAd: [SAAd,/*  SAAD,  */SAAE, ELRL],             
    SABd: [SABd, SACd, SADd, SAAd,/*  SABD, SAAD,  */SAAE, ELRL], 
    SACd: [SACd, SADd, SAAd,/*  SACD, SAAD,  */SAAE, ELRL], 
    SADd: [SADd, SAAd,/*  SADD, SAAD,  */SAAE, ELRL],
//第三轨准轨
    SAA3: [SAA3, SAB3, SAC3, SAD3, "3RDR", MTRO, ELRL],
    SAB3: [SAB3, SAC3, SAD3, SAA3, "3RDR", MTRO, ELRL],
    SAC3: [SAC3, SAD3, SAA3, "3RDR", MTRO, ELRL],
    SAD3: [SAD3, SAA3, "3RDR", MTRO, ELRL],
//窄轨
    NAAN: [NAAN, NGRL],
    NABN: [NACN, NAAN, NGRL],
    NAAA: [NAAA, NAAE, ELNG],
    NABA: [NACA, NAAA, NAAE, ELNG],
    NAAD: [NAAD, NAAE, ELNG],
    NABD: [NABD, NAAD, NAAE, ELNG],
//俄罗斯宽轨
    BAAN: [BAAN, RLA0, RAIL],       
    BABN: [BABN, BACN, BADN, BAAN, RLA0, RAIL], 
    BACN: [BACN, BADN, BAAN, RLA0, RAIL], 
    BADN: [BADN, BAAN, RLA0, RAIL],
//俄罗斯25kv宽轨
    BAAA: [BAAA, BAAE, ERA1, ELRL],       
    BABA: [BABA, BACA, BADA, BAAA, BAAE, ERA1, ELRL], 
    BACA: [BACA, BADA, BAAA, BAAE, ERA1, ELRL], 
    BADA: [BADA, BAAA, BAAE, ERA1, ELRL], 
//准轨-宽轨 套轨 (可变轨距车)
    DAAN: [DAAN, DABN, DACN, DADN, DAEN, SAAN, SABN, SACN, SADN, SAEN, BAAN, BABN, BACN, BADN, RAIL],
    DABN: [DABN, DACN, DADN, DAEN, DAAN, SABN, SACN, SADN, SAEN, SAAN, BABN, BACN, BADN, BAAN, RAIL],
    DACN: [DACN, DADN, DAEN, DAAN, SACN, SADN, SAEN, SAAN, BACN, BADN, BAAN, RAIL], //1819客车
    DAAA: [DAAA, DABA, DACA, DADA, DAEA, DAAE, SAAA, SABA, SACA, SADA, SAEA, SAAE, BAAA, BABA, BACA, BADA, BAAE, ELRL],
    DABA: [DABA, DACA, DADA, DAEA, DAAA, DAAE, SABA, SACA, SADA, SAEA, SAAA, SAAE, BABA, BACA, BADA, BAEA, BAAE, ELRL], //可变轨距动车
}

