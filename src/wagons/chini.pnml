// Begin CHINI
switch (FEAT_TRAINS, SELF, switch_chini_name, getbits(extra_callback_info1, 0, 8) == 0x20? getbits(extra_callback_info1, 8, 8) : 0xFFFF) {
    0: return string(STR_FLATCAR);
    return CB_RESULT_NO_TEXT;
}
// Graphics

// Purchase Menu
spriteset (spriteset_chini_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_purchase ("wagons/smr", "chini")
}

// Vehicle
spriteset (spriteset_chini_original_empty, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini")
}
spriteset (spriteset_chini_original_bucket_half, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-bucket-half")
}
spriteset (spriteset_chini_original_bucket_full, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-bucket-full")
}
spriteset (spriteset_chini_original_goods_half, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-goods-half")
}
spriteset (spriteset_chini_original_goods_full, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-goods-full")
}
spriteset (spriteset_chini_original_metal_half, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-steel-half")
}
spriteset (spriteset_chini_original_metal_full, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-steel-full")
}
spriteset (spriteset_chini_original_cover, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    template_standard ("wagons/smr", "chini-cover")
}


switch (FEAT_TRAINS, SELF, switch_chini_original, cargo_count < 5) {
    0: spriteset_chini_original_cover;
    spriteset_chini_original_empty;
}

switch (FEAT_TRAINS, SELF, switch_chini_original_metal, cargo_count) {
    0..5: spriteset_chini_original_empty;
    6..30: spriteset_chini_original_metal_half;
    31..90: spriteset_chini_original_metal_full;
}

switch (FEAT_TRAINS, SELF, switch_chini_original_bucket, cargo_count) {
    0..5: spriteset_chini_original_empty;
    6..30: spriteset_chini_original_bucket_half;
    spriteset_chini_original_bucket_full;
}


switch (FEAT_TRAINS, SELF, switch_chini_original_goods_more_than_0_percent, cargo_count) {
    0..5: spriteset_chini_original_empty;
    6..38: spriteset_chini_original_goods_half;
    spriteset_chini_original_goods_full;
}

switch (FEAT_TRAINS, SELF, switch_chini_original_all_cargo, cargo_type_in_veh) {
// the following list is shamelessly stolen from xUSSR
    ALUM: switch_chini_original_metal;
    COPR: switch_chini_original_metal;
    CSTI: switch_chini_original_metal;
    IRON: switch_chini_original_metal;
    METL: switch_chini_original_metal;
    PIPE: switch_chini_original_metal;
    STEL: switch_chini_original_metal;
    STAL: switch_chini_original_metal;
    STST: switch_chini_original_metal;
    STCB: switch_chini_original_metal;
    STSE: switch_chini_original_metal;
    STSH: switch_chini_original_metal;
    STWR: switch_chini_original_metal;
    ZINC: switch_chini_original_metal;

    EOIL: switch_chini_original_bucket;
    FZDR: switch_chini_original_bucket;
    WATR: switch_chini_original_bucket;
    OIL_: switch_chini_original_bucket;
    PETR: switch_chini_original_bucket;
    RFPR: switch_chini_original_bucket;
    BUBL: switch_chini_original_bucket;
    COAT: switch_chini_original_bucket;
    DYES: switch_chini_original_bucket;
    NHNO: switch_chini_original_bucket;
    PLAS: switch_chini_original_bucket;
    PLST: switch_chini_original_bucket;
    RUBR: switch_chini_original_bucket;
    SOAP: switch_chini_original_bucket;
    ACID: switch_chini_original_bucket;
    CTAR: switch_chini_original_bucket;
    LYE_: switch_chini_original_bucket;
    C2H4: switch_chini_original_bucket;
    CHLO: switch_chini_original_bucket;
    FUEL: switch_chini_original_bucket;
    H2__: switch_chini_original_bucket;
    N7__: switch_chini_original_bucket;
    NH3_: switch_chini_original_bucket;
    O2__: switch_chini_original_bucket;

    VEHI: switch_chini_original;
    FMSP: switch_chini_original;
    ENSP: switch_chini_original;

    switch_chini_original_goods_more_than_0_percent;
}

random_switch (FEAT_TRAINS, SELF, random_chini_colour) {
    1: switch_chini_original_all_cargo; // More colours waiting to be added
}

switch (FEAT_TRAINS, SELF, switch_chini_articulated_part, extra_callback_info1) {
    1..2: return chini;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, switch_chini_graphics, position_in_articulated_veh % 3) {
    1: random_chini_colour;
    empty_sprites;
}

switch (FEAT_TRAINS, SELF, switch_chini_capacity_cargo, cargo_type_in_veh) {
    GOOD: return 75;
    return 50;
}

switch (FEAT_TRAINS, SELF, switch_chini_capacity, position_in_articulated_veh % 3) {
    1: switch_chini_capacity_cargo;
    return 0;
}

switch (FEAT_TRAINS, SELF, switch_chini_loading_speed, cargo_type_in_veh) {
    GOOD: return 15;
    return 10;
}

item (FEAT_TRAINS, chini) {
    property {
        // Menu
        name:                           string(STR_NAME_CHINI);
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);

        // Availability
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1907,01,01);
        model_life:                     60;
        retire_early:                   15;
        vehicle_life:                   30;
        track_type:                     SACN;

        // Cargo
        refittable_cargo_classes:       bitmask(CC_EXPRESS, CC_LIQUID, CC_HAZARDOUS, CC_PIECE_GOODS, CC_COVERED, CC_OVERSIZED);
        non_refittable_cargo_classes:   bitmask(CC_PASSENGERS, CC_BULK);
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [YETI, YETY];
        refit_cost:                     0;
        default_cargo_type:             DEFAULT_CARGO_FIRST_REFITTABLE;
        ai_special_flag:                AI_FLAG_CARGO;
        cargo_capacity:                 60;
        loading_speed:                  10 << param_loading_speed;
        cargo_age_period:               185 << param_cargo_decay;

        // Stats
        speed:                          65 km/h;
        power:                          0 hp;
        weight:                         10 ton;
        cost_factor:                    8;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        running_cost_factor:            6;
    }
    graphics {
        // Menu
        additional_text:                string(STR_DESC_2, string(STR_SMR_VEHICLE),  string(STR_FRESHNESS_MEDIUM, 185));
        can_attach_wagon:               locowagon;

        // Graphics
        default:                        switch_chini_graphics;
        purchase:                       spriteset_chini_purchase;
        articulated_part:               switch_chini_articulated_part;

        // Stats
        length:                         switch_length_2_1_2;
        cargo_capacity:                 switch_chini_capacity;
        loading_speed:                  switch_chini_loading_speed() << param_loading_speed;
        cargo_age_period:               185 << (param_cargo_decay + param_wagoncargodecay);
        cost_factor:                    4;
        running_cost_factor:            3 * runningcostfactor();
        purchase_running_cost_factor:   12;
        purchase_cargo_capacity:        50/3;
        name:                           switch_chini_name;
    }
}

// End CHINI